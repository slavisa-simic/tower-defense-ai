                GameObject visual;
                if (pool.Count > 0) { visual = pool.Pop(); ReusedBoatVisuals++; }
                else { visual = Instantiate(source, point.riverEntry, Quaternion.identity, transform); visualSources[visual] = source; CreatedBoatVisuals++; }
