* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
# Unity serializes empty YAML values with a trailing space.
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol
*.anim text eol=lf whitespace=-blank-at-eol
*.controller text eol=lf whitespace=-blank-at-eol
*.spriteatlas text eol=lf whitespace=-blank-at-eol
*.txt text eol=lf
