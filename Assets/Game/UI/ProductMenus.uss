.product-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(10, 18, 19, 0.82); align-items: center; justify-content: center; }
.product-card { width: 540px; max-width: 90%; max-height: 90%; padding: 24px; background-image: url("../Art/UI/bd_ui_hud_panel_large_v001.png"); -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16; color: rgb(210, 204, 177); font-size: 16px; }
.product-scroll { flex-shrink: 1; }
.product-title { color: rgb(227, 197, 123); font-size: 25px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 16px; }
.product-copy { white-space: normal; font-size: 14px; margin-bottom: 14px; -unity-text-align: middle-center; }
.product-button { height: 40px; flex-shrink: 0; margin: 4px 16px; border-radius: 0; border-width: 1px; border-color: rgb(99, 109, 77); color: rgb(210, 204, 177); background-color: rgb(30, 41, 36); font-size: 15px; }
.product-button:hover, .product-button:focus { border-color: rgb(227, 197, 123); background-color: rgb(53, 62, 42); }
.product-button:active { background-color: rgb(77, 79, 46); border-width: 2px; }
.product-button:disabled { opacity: 0.4; border-color: rgb(66, 68, 61); }
.product-card Toggle, .product-card DropdownField { margin-bottom: 12px; min-height: 30px; color: rgb(210, 204, 177); }
.product-card .unity-base-field__label { min-width: 190px; }
.product-card .unity-base-field__input { background-color: rgb(35, 45, 39); color: rgb(227, 218, 185); border-color: rgb(99, 109, 77); border-width: 1px; border-radius: 0; }
.product-card .unity-popup-field__text { color: rgb(227, 218, 185); }
.product-card .unity-toggle__checkmark { background-color: rgb(149, 161, 114); border-color: rgb(150, 159, 118); border-width: 1px; }
.product-card .unity-popup-field__arrow { -unity-background-image-tint-color: rgb(227, 218, 185); }
.management-button:active, .defense-button:active { background-color: rgb(66, 71, 45); border-color: rgb(227, 197, 123); }
.save-feedback { position: absolute; top: 94px; right: 18px; max-width: 235px; color: rgb(184, 201, 156); font-size: 10px; white-space: normal; }
.runtime-tooltip { position: absolute; max-width: 350px; padding: 12px; color: rgb(227, 218, 185); background-color: rgb(22, 32, 30); border-width: 1px; border-color: rgb(149, 130, 80); font-size: 13px; white-space: normal; }
.research-card { width: 1180px; max-width: 96%; padding: 18px; background-color: rgb(17, 28, 29); }
.research-card .product-title { margin-bottom: 5px; color: rgb(166, 218, 214); font-size: 22px; }
.research-balance-row { flex-direction: row; justify-content: center; align-items: center; }
.research-rp-icon { width: 32px; height: 32px; margin-right: 8px; }
.research-balance { color: rgb(156, 218, 219); font-size: 17px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 7px; }
.research-note { font-size: 11px; color: rgb(171, 185, 174); -unity-text-align: middle-center; margin-bottom: 10px; white-space: normal; }
.research-body { flex-direction: row; }
.research-branches { flex-direction: row; flex-grow: 1; }
.research-column { width: 25%; padding: 0 4px; }
.research-branch-title { height: 28px; font-size: 12px; color: rgb(170, 202, 180); -unity-text-align: middle-center; }
.research-branch-board { height: 406px; background-color: rgb(20, 34, 34); border-width: 1px; border-color: rgb(48, 73, 72); }
.research-node { padding: 3px 2px; margin-top: 0; margin-bottom: 0; border-radius: 0; border-width: 1px; border-color: rgb(105, 154, 154); background-color: rgb(30, 48, 46); align-items: center; }
.research-node:hover, .research-node:focus, .research-node.node-selected { border-color: rgb(220, 207, 146); border-width: 2px; background-color: rgb(47, 64, 56); }
.research-node.node-locked { background-color: rgb(25, 32, 32); border-color: rgb(68, 79, 77); }
.node-locked .research-node-icon { opacity: 0.3; }
.node-locked .research-node-name { color: rgb(151, 157, 147); }
.research-node.node-purchased { background-color: rgb(33, 63, 55); border-color: rgb(137, 193, 152); border-width: 2px; }
.research-node.node-insufficient { border-color: rgb(151, 126, 77); }
.research-node-icon { width: 32px; height: 32px; }
.research-node-name { font-size: 8px; color: rgb(222, 219, 195); white-space: normal; -unity-text-align: middle-center; height: 29px; }
.research-node-state { font-size: 8px; color: rgb(169, 208, 201); }
.research-detail { width: 240px; flex-shrink: 0; margin-left: 12px; padding: 12px; background-color: rgb(24, 38, 37); border-width: 1px; border-color: rgb(73, 104, 99); }
.research-detail-icon { height: 56px; width: 56px; align-self: center; margin-bottom: 10px; }
.research-detail-title { font-size: 16px; color: rgb(208, 218, 183); white-space: normal; margin-bottom: 12px; }
.research-detail-copy { font-size: 12px; white-space: normal; color: rgb(180, 195, 182); margin-bottom: 10px; }
.research-detail .product-button { margin: 4px 0; font-size: 12px; }
.preparation-intelligence { position: absolute; top: 134px; left: 16px; max-width: 255px; padding: 9px; background-color: rgba(15, 31, 33, 0.92); border-width: 1px; border-color: rgb(72, 124, 127); font-size: 10px; color: rgb(170, 214, 206); white-space: normal; }
