<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; padding-left: 24px; padding-top: 20px;">
        <ui:Label name="base-hp" text="BASE HP: 100 / 100" picking-mode="Ignore" style="font-size: 24px; color: white; -unity-font-style: bold; background-color: rgba(15, 23, 30, 0.85); padding-left: 14px; padding-right: 14px; padding-top: 8px; padding-bottom: 8px; align-self: flex-start;" />
        <ui:Label name="game-over" text="GAME OVER" picking-mode="Ignore" style="display: none; position: absolute; left: 0; right: 0; top: 45%; font-size: 44px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgba(15, 23, 30, 0.85); padding-top: 16px; padding-bottom: 16px;" />
    </ui:VisualElement>
</ui:UXML>
